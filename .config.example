# checkin - web check-in site list (TOML)
# ---------------------------------------------------------------------------
# Copy this file to `.config` and edit it:
#     cp .config.example .config          (Windows: copy .config.example .config)
#
# Each site needs exactly two fields:
#   name - any label; also used as the cookie file name (cookies/<name>.json)
#   url  - the page that shows the daily check-in button after you log in
#          (a normal page link, NOT the backend API endpoint - the API needs a
#           live token/signature that only the page itself can produce)
#
# Optional third field:
#   login_only - set to true for "public welfare" sites where being logged in and
#                opening the page IS the daily check-in (there is no check-in
#                button). A successfully opened page then counts as success,
#                instead of failing with "no check-in button found".
#
# Optional JSON API fields (for sites whose check-in is an API call, often hidden
# behind a tab or only triggered by the site's own JavaScript):
#   checkin_api  - endpoint that performs the check-in (relative to url, or an
#                  absolute URL). It is called silently with the saved cookies
#                  first and, when that fails, from inside the browser - so a WAF
#                  challenge or a login kept in localStorage is already satisfied.
#   csrf_api     - endpoint returning {"csrf": "..."}; the token is sent as the
#                  X-CSRF header with the check-in request.
#   browser_only - never try the silent HTTP tier (set it for sites behind a WAF
#                  that only a real browser can pass, e.g. Any Router).
#
# How a check-in runs (nothing else to configure):
#   1. silent   GET the url with the saved cookies; if the page says
#               "already checked in" or "success" we are done - no window
#   2. headless if step 1 cannot confirm (401/403, login redirect, unclear
#               text), open the url in headless Chrome/Edge, click the
#               check-in button and read the result (screenshot saved)
#
# Log in once per site so the cookies exist:
#     python scripts\web_checkin.py --login <name>
#
# The real `.config` is git-ignored; this template is the one that is committed.
# ---------------------------------------------------------------------------

# Uncomment and edit this block for each site you want to check in:
#
# [[sites]]
# name = "example"
# url = "https://example.com/checkin"
#
# [[sites]]
# name = "another-site"
# url = "https://another.example.com/daily"
#
# Login-only site (opening the page is the check-in):
# [[sites]]
# name = "Any Router"
# url = "https://anyrouter.top/console/topup"
# login_only = true
# checkin_api = "/api/user/sign_in"
# browser_only = true
#
# Site whose check-in is a JSON API behind a tab (404-style):
# [[sites]]
# name = "404"
# url = "https://wb.404-found.uk/hb/me"
# checkin_api = "/hb/api/v1/checkin"
# csrf_api = "/hb/api/v1/me"

# ---------------------------------------------------------------------------
# Notifications - cookie expiry alerts (see scripts/notify.py)
# ---------------------------------------------------------------------------
# When a saved session in cookies/<name>.json stops working (HTTP 401/403, a
# login redirect, or the site asking for a login) the run pushes ONE summary
# message so you can re-login before the next check-in silently fails.
#
#   on = "expired" - only a dead/expiring cookie triggers a message (default)
#   on = "failure" - any failed check-in run triggers a message
#   on = "always"  - every run triggers a message
#
# The endpoint is a WeCom (企业微信) hook that speaks a plain JSON POST. It does
# NOT need to be the official qyapi.weixin.qq.com robot URL - any endpoint that
# accepts one of the body shapes below works (self-hosted bridge, gateway,
# reverse proxy, ...).
#
#   url = the full endpoint, for example:
#         http://192.168.2.6:8645/hook            (LAN, same subnet)
#         https://<your-host>:<port>/hook         (public)
#         http://127.0.0.1:8645/hook              (same machine / container)
#
# Authentication (both accepted, the header is preferred because a token in a
# URL ends up in access logs):
#         POST <url>          header: X-Hook-Token: <WECOM_HOOK_TOKEN>
#         POST <url>?token=<WECOM_HOOK_TOKEN>
#
# Request bodies the endpoint may accept (notify.py sends body #1 or #2):
#   1) {"text": "..."}                                  (generic)
#   2) {"msgtype": "text", "text": {"content": "..."}}  (WeCom robot shape)
#   3) {"markdown": {"content": "..."}}
#   4) a raw text body  (Content-Type: text/plain)
#   5) GET <url>?token=<WECOM_HOOK_TOKEN>&text=...
# A GET without `text` is treated as a connectivity probe and sends nothing.
#
# Optional routing / mode fields in the JSON body:
#   "to": "<name>"        override the target chat (default = the hook's own)
#   "mode": "notify"      push a robot message only (default; no LLM, no agent)
#   "mode": "agent"       push the text into a chat session and let the bot reply
#
# The token is NOT stored in this file. Provide it in one of two places:
#   * the CHECKIN_WEBHOOK_TOKEN environment variable, or
#   * a `.hook_token` file in the project root (git-ignored; copy
#     .hook_token.example and replace the placeholder line).
# Environment wins over the file. In all docs the value is written as
# <WECOM_HOOK_TOKEN>; never commit the real one.
#
# When the webhook itself cannot deliver (bad token, host down, rate limited,
# token not configured) the message is ALSO shown as a Windows popup, so a
# token rotation can never make an alert disappear silently. The popup runs in
# a detached process, stays on top, auto-closes after popup_timeout seconds and
# never blocks the check-in run. Disable it with popup_fallback = false.
#
# [notify]
# enabled = true
# url = "http://192.168.2.6:8645/hook"
# on = "expired"
# expiry_warn_days = 3
# to = ""                      # optional; empty = the hook's default chat
# timeout = 8                  # per-request timeout (seconds)
# retries = 2                  # retries on 429/5xx only, with 2s/5s backoff
# popup_fallback = true        # Windows popup when the webhook cannot deliver
# popup_timeout = 60           # seconds before the fallback popup closes itself
#
# Delivery behaviour worth knowing:
#   * the endpoint may rate-limit (often 30 requests / 60 s); this project sends
#     at most ONE summary per run, so that ceiling is never reached
#   * a failed delivery is NOT recorded as "already sent", so the next run
#     retries it
#   * the same status is sent at most once per day (logs/.notify_state.json)
#   * responses look like {"errcode": 0, "errmsg": "ok", "ok": true, ...};
#     0 means delivered. Common errors:
#         40001 / HTTP 403  wrong token (this is what the popup covers)
#         45009 / HTTP 429  rate limited (retried, then popped up)
#         40058 / HTTP 400  no text in the body
#         50001 / HTTP 503  token not configured on the hook host
#         50002 / HTTP 500  no target chat
#         50003 / HTTP 502  WeCom side rejected the message
#         40006 / HTTP 413  body too large
